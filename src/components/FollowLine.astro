---
import { SOCIAL } from "../consts"
import BrandMark from "./BrandMark.astro"

interface Props {
  class?: string
}

const { class: className } = Astro.props

// X first — it's the one that should catch the eye.
const links = [SOCIAL.x, SOCIAL.github, SOCIAL.linkedin]
---

<p class:list={["follow", className]}>
  <span class="prefix">Follow me on</span>

  <span class="buttons">
    {
      links.map(({ href, chipLabel, key }) => (
        <a href={href} rel="me" class:list={["chip", key]}>
          <BrandMark name={key} />
          <span>{chipLabel}</span>
        </a>
      ))
    }
  </span>
</p>

<style>
  .follow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    font-size: var(--step-0);
  }

  .prefix {
    color: var(--text-muted);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.34em 0.72em;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
    color: var(--text);
    font-size: 0.92em;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .chip svg {
    width: 1em;
    height: 1em;
    flex: 0 0 auto;
  }

  /* The X mark is optically heavier than the other two at the same box size. */
  .chip.x svg {
    width: 0.88em;
    height: 0.88em;
  }

  .chip:hover {
    color: var(--accent-text);
    border-color: var(--accent-dim);
    background: var(--accent-wash);
  }

  .chip:focus-visible {
    outline-offset: 2px;
  }
</style>
