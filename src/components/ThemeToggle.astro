---
/**
 * Two-position switch rather than a single icon button: with both options
 * always visible there is nothing to decode, and the highlighted half tells you
 * which theme is active.
 *
 * Not a React island. This is the only interactive control on the site and
 * hydrating React for it would cost ~57 kB gzip on every page. @astrojs/react
 * stays configured for anything that genuinely needs it (the hero orb does).
 *
 * BaseHead applies the stored theme before first paint, so there is no flash.
 */
---

<div class="theme-switch">
  <button type="button" data-set-theme="light" aria-label="Use light theme">
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.4v2.2M12 19.4v2.2M4.4 4.4l1.6 1.6M18 18l1.6 1.6M2.4 12h2.2M19.4 12h2.2M4.4 19.6l1.6-1.6M18 6l1.6-1.6"></path>
    </svg>
  </button>
  <button type="button" data-set-theme="dark" aria-label="Use dark theme">
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.5 13.2A8.4 8.4 0 1 1 11.3 3.6a6.6 6.6 0 0 0 9.2 9.6z"></path>
    </svg>
  </button>
</div>

<style>
  .theme-switch {
    display: inline-flex;
    align-items: center;
    margin-inline-start: var(--space-2xs);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .theme-switch button {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.6rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .theme-switch button + button {
    border-inline-start: 1px solid var(--line-strong);
  }

  .theme-switch button:hover {
    color: var(--text);
  }

  /* the active half */
  :global([data-theme="light"]) .theme-switch button[data-set-theme="light"],
  :global([data-theme="dark"]) .theme-switch button[data-set-theme="dark"] {
    background: var(--accent-wash);
    color: var(--accent);
  }
</style>

<script>
  function wireThemeSwitch() {
    const root = document.documentElement
    document
      .querySelectorAll<HTMLButtonElement>(".theme-switch [data-set-theme]")
      .forEach((button) => {
        if (button.dataset.wired === "true") return
        button.dataset.wired = "true"
        button.addEventListener("click", () => {
          const next = button.dataset.setTheme
          if (!next) return
          root.dataset.theme = next
          try {
            localStorage.setItem("theme", next)
          } catch {
            /* private browsing — the choice just won't stick */
          }
        })
      })
  }

  wireThemeSwitch()
  // View Transitions swap the DOM, so re-wire after each navigation.
  document.addEventListener("astro:page-load", wireThemeSwitch)
</script>
