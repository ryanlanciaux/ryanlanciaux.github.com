---
import PostCard from "./PostCard.astro"
import { excerpt, postHref, type Post } from "../utils/posts"

interface Props {
  posts: Post[]
  /** Continues the running index across paginated pages. */
  offset?: number
}

const { posts, offset = 0 } = Astro.props
---

<div class="list">
  {
    posts.map((post, i) => (
      <PostCard
        href={postHref(post)}
        title={post.data.title}
        date={post.data.date}
        summary={post.data.description ?? excerpt(post.body)}
        index={offset + i}
      />
    ))
  }
</div>

<style>
  .list {
    border-block-start: 1px solid var(--line);
  }
</style>
