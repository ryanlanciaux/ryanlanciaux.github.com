---
import ThemeToggle from "./ThemeToggle.astro"

/**
 * The wordmark is real text, not the old lanciaux.svg. That file held live
 * <text> set in Titillium, a font no visitor has installed, so it silently fell
 * back to a serif and clashed with everything else on the page. Setting it in
 * the site's own typeface keeps the header and the hero identical.
 */
const path = Astro.url.pathname
const isHome = path === "/" || /^\/\d+\/$/.test(path)
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Ryan Lanciaux — home">
      <span class="wordmark">Ryan Lanciaux</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        <li>
          <a href="/" aria-current={isHome ? "page" : undefined}>Writing</a>
        </li>
        <li><a href="/rss.xml">Feed</a></li>
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(140%) blur(14px);
    border-block-end: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 3.4rem;
  }

  @media (min-width: 48rem) {
    .header-inner {
      min-height: 2.7rem;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.015em;
    white-space: nowrap;
  }

  .brand:hover .wordmark {
    color: var(--accent-text);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav ul a {
    display: block;
    padding: var(--space-3xs) var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    text-decoration: none;
  }

  nav ul a:hover {
    color: var(--text);
  }

  nav ul a[aria-current="page"] {
    color: var(--accent);
  }

  @media (max-width: 26rem) {
    .wordmark {
      font-size: var(--step--1);
    }
    nav ul a {
      padding-inline: var(--space-3xs);
    }
  }
</style>
