---
import { SOCIAL_LINKS, SITE_AUTHOR } from "../consts"
import BrandMark from "./BrandMark.astro"

const year = new Date().getFullYear()

const elsewhere = [
  ...SOCIAL_LINKS,
  { href: "/rss.xml", label: "RSS", key: undefined },
]
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="label">
      &copy; {year} {SITE_AUTHOR} &middot; built with <a href="https://astro.build"
        >Astro</a
      >
    </p>
    <ul>
      {
        elsewhere.map(({ href, label, key }) => (
          <li>
            {/* X reads as "@handle on <logo>": the network name is a mark, not
                a word, so it goes in as one. aria-label keeps the accessible
                name intact since the mark carries no text. */}
            <a
              class="label"
              href={href}
              aria-label={key === "x" ? `${label} on X` : undefined}
            >
              {label}
              {key === "x" && (
                <>
                  <span class="on"> on </span>
                  <BrandMark name="x" class="mark" />
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: auto;
    padding-block: var(--space-l);
    border-block-start: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .on {
    /* .label tracks at 0.14em, which swallows the spaces around a short word */
    letter-spacing: normal;
    padding-inline: 0.5em 0.55em;
  }

  a :global(.mark) {
    width: 0.95em;
    height: 0.95em;
  }

  a:hover {
    color: var(--accent);
  }
</style>
